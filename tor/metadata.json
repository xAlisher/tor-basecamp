{
  "name": "tor",
  "version": "0.1.0",
  "type": "core",
  "category": "networking",
  "description": "Headless Tor capability: HTTP over Tor, a shared SOCKS endpoint, v3 client authorization, and onion-service hosting. One tor instance for all Basecamp apps.",
  "author": "xAlisher",
  "interface": "universal",
  "main": "tor_plugin",
  "codegen": {
    "impl_header": "tor_impl.h"
  },
  "icon": "",
  "dependencies": [],
  "capabilities": [],
  "nix": {
    "external_libraries": [],
    "cmake": {
      "extra_include_dirs": [
        "src"
      ],
      "find_packages": [
        "OpenSSL REQUIRED"
      ],
      "extra_link_libraries": [
        "OpenSSL::Crypto"
      ]
    },
    "packages": {
      "build": [
        "pkg-config"
      ],
      "runtime": [
        "openssl"
      ]
    }
  }
}